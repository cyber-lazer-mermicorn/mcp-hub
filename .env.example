# MCP access boundary
# Use a randomly generated secret. Clients must provide it with each MCP request.
MCP_API_TOKEN=replace_with_a_long_random_secret
# Tools may read only relative files below this existing directory.
MCP_READ_ROOT=/srv/mcp-data

# Core AI
OPENAI_API_KEY=your_openai_key
GROQ_API_KEY=your_groq_key

# Supabase: use an RLS-scoped key only. Do not configure a service-role key for generic MCP tools.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
# Comma-separated simple table names that the MCP connector may access.
SUPABASE_MCP_ALLOWED_TABLES=approved_table_one,approved_table_two

# Vercel
VERCEL_API_TOKEN=your_vercel_api_token

# Hugging Face
HF_API_TOKEN=your_huggingface_api_token

# Linear
LINEAR_API_KEY=your_linear_api_key
